{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],

    /*
      This app was written in JSX and converted. `noImplicitAny` stays off while the
      remaining untyped component props are annotated pass by pass; every other strict
      check (null safety above all) is already on, and those are the ones that catch
      real bugs. Turning this on is the last step of the conversion, not the first.
    */
    "noImplicitAny": false,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "vite.config.ts", "tailwind.config.ts"]
}
