{
  "name": "@shippingco/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Validated Fastify HTTP boundary and PostgreSQL runtime composition",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "node --experimental-strip-types src/index.ts",
    "test": "vitest run",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@shippingco/db": "workspace:*",
    "@shippingco/shared": "workspace:*",
    "fastify": "5.12.3",
    "file-type": "22.1.1"
  },
  "devDependencies": {
    "@shippingco/testkit": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
