# Copy to ignored local environment. Never commit resolved credentials.
# Browser configuration is public; API config must not be supplied to Vite.
TWENTY_FIRST_API_KEY=

# Optional public browser configuration (future API adapter):
# VITE_API_BASE_URL=
# VITE_APP_VERSION=

# API required config; .env is not loaded automatically.
# NODE_ENV accepts development (developer), demo, staging, production only.
NODE_ENV=
HOST=
PORT=
LOG_LEVEL=
ALLOWED_ORIGINS=
# Explicit 0 trusts no forwarding; 1-5 requires exact IPs below.
TRUSTED_PROXY_HOPS=
# TRUSTED_PROXY_ADDRESSES=
DATABASE_SECRET_REF=
# disable or verify-full; staging/production require verify-full.
DATABASE_TLS_MODE=
# DATABASE_CA_PEM=

# Local-only: development + local:database reference, loopback shipit_developer
# database and db_developer login. Never available to hosted modes or browser.
# LOCAL_DATABASE_URL=
# Optional issue #13 authentication API. Live provider setup is deferred to M3.
# AUTH_SECRET_REF=
# Local development only; ignored secret JSON, never browser configuration.
# LOCAL_AUTH_JSON=

# Future feature-owned managed-secret references (not consumed by Issue #11):
# SESSION_SIGNING_KEY_REF=
# OTP_PEPPER_REF=
# WHATSAPP_ACCESS_TOKEN_REF=
# WHATSAPP_APP_SECRET_REF=
# WHATSAPP_VERIFY_TOKEN_REF=
# STORAGE_CREDENTIAL_REF=
# CARRIER_CREDENTIAL_REF=
