# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Nothing here is read by the application. The web app has no backend and makes no
# network calls at runtime, so no value in this file ever reaches the browser bundle.
# These are developer-machine credentials for tooling only.

# 21st.dev component registry — used when pulling UI components during development.
TWENTY_FIRST_API_KEY=

# ---------------------------------------------------------------------------
# The API and database are not implemented yet. When they are, their environment
# belongs in apps/api/.env rather than here, so that the web app can never read a
# database password by accident.
#
# DATABASE_URL=postgres://shippingco:shippingco@localhost:5432/shippingco
