# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
# Nothing here is read by the application. The web app has no backend and makes no
# network calls at runtime, so no value in this file ever reaches the browser bundle.
# These are developer-machine credentials for tooling only.

# 21st.dev component registry — used when pulling UI components during development.
TWENTY_FIRST_API_KEY=

# ---------------------------------------------------------------------------
# The API and database are not implemented yet. The names below document the
# Issue #6 contract only. Secret entries hold managed-secret REFERENCES, never values.
# Server environment belongs with apps/api, so the web app cannot read it.
#
# Public browser configuration (anything VITE_ is public):
# VITE_API_BASE_URL=
# VITE_APP_VERSION=
#
# Server-only configuration:
# NODE_ENV=
# PORT=
# LOG_LEVEL=
# ALLOWED_ORIGINS=
# TRUSTED_PROXY_HOPS=
#
# Server-only managed-secret references:
# DATABASE_SECRET_REF=
# SESSION_SIGNING_KEY_REF=
# OTP_PEPPER_REF=
# WHATSAPP_ACCESS_TOKEN_REF=
# WHATSAPP_APP_SECRET_REF=
# WHATSAPP_VERIFY_TOKEN_REF=
# STORAGE_CREDENTIAL_REF=
# CARRIER_CREDENTIAL_REF=
