# ShippingCo application configuration reference.
# Copy to an ignored file such as .env.local and replace the REPLACE_* values.
# Never put real keys, tokens, passwords or customer details in this tracked file.
# Keep existing local encryption/signing keys when updating an installation.
#
# Root commands load .env.database.local, .env, then .env.local automatically.
# Later files override earlier files; existing shell variables override all files.
#   pnpm db           (start the existing Docker database; Docker must be running)
#   pnpm db:migrate   (apply migrations with the separate owner credential)
#   pnpm api          (API server)
#   pnpm worker       (notification worker, in another terminal)
# The worker needs the WhatsApp catalog, webhook and automation bindings below.
# Main software UI: pnpm web (or pnpm dev) -> http://localhost:5173/
# Web imports only VITE_* and SHIPIT_API_PROXY from these root files.
# Node env parsing supports the quoted multiline JSON shown below.
# Optional blocks are commented out: uncomment the reference AND its entire JSON
# assignment together, after filling its placeholders and prerequisites.
# Do not overwrite an existing .env.database.local or its credentials with examples.

# --- Required API / worker runtime ---
# development maps to developer. Other accepted modes: demo, staging, production.
# NODE_ENV=test is reserved for disposable test tooling.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Comma-separated canonical browser origins; no trailing slash or wildcard.
ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_PROXY_HOPS=0
# Required exact proxy IPs when TRUSTED_PROXY_HOPS is 1-5. Omit for zero hops.
# TRUSTED_PROXY_ADDRESSES=127.0.0.1

# --- Database: runtime login and separate migration owner ---
# Existing persistent Docker container used by pnpm db / pnpm db:start.
# LOCAL_DB_CONTAINER=shipit-postgres-local
# Developer CLI requires this exact local reference, loopback host, database name
# shipit_developer and runtime user db_developer. URL-encode password characters.
DATABASE_SECRET_REF=local:database
DATABASE_TLS_MODE=disable
LOCAL_DATABASE_URL=postgresql://db_developer:REPLACE_RUNTIME_PASSWORD@127.0.0.1:5432/shipit_developer
SHIPIT_ENVIRONMENT=developer
MIGRATION_DATABASE_URL=postgresql://REPLACE_MIGRATION_OWNER:REPLACE_MIGRATION_PASSWORD@127.0.0.1:5432/shipit_developer
# Staging/production require verify-full. API accepts certificate PEM text;
# migration CLI accepts a certificate file path. Omit both for local disable mode.
# DATABASE_CA_PEM="REPLACE_WITH_TRUSTED_CA_PEM"
# DATABASE_CA_FILE=C:/path/to/trusted-ca.pem
# Hosted deployment uses a managed SecretResolver and pinned secret references.
# It cannot use LOCAL_* credentials or the developer CLI as a deployment launcher.

# --- Operator sign-in: Resend email and authentication keys ---
# Required for the main UI's enrolled-operator email/code sign-in.
# The code reads the Resend key from email.apiKey inside this JSON;
# a standalone RESEND_API_KEY variable is NOT consumed.
# email.from must be a plain email address accepted by your Resend sender setup.
# testRecipients is the exact allowlist for developer auth sends (at most 10).
# Set it to your enrolled operator email. This is NOT the booking customer list.
# Each key must be independently generated: 32 random bytes as 64 lowercase hex.
# Keep keys stable across restarts; never use the placeholders as keys.
# Example generation: node -p "require('node:crypto').randomBytes(32).toString('hex')"
AUTH_SECRET_REF=local:auth
LOCAL_AUTH_JSON='{
  "keys": {
    "version": "v1",
    "verifier": "REPLACE_AUTH_VERIFIER_64_HEX",
    "encryption": "REPLACE_AUTH_ENCRYPTION_64_HEX",
    "browser": "REPLACE_AUTH_BROWSER_64_HEX"
  },
  "testRecipients": ["operator@example.com"],
  "email": {
    "apiKey": "REPLACE_RESEND_API_KEY",
    "from": "notifications@example.com"
  }
}'
# Optional WhatsApp sign-in: merge this property into LOCAL_AUTH_JSON only after
# the exact authentication template is approved. The main UI currently uses email.
# Hosted enabled auth requires both email and whatsapp provider configuration.
# "whatsapp": {"token":"REPLACE_META_ACCESS_TOKEN","phoneNumberId":"REPLACE_PHONE_NUMBER_ID","apiVersion":"v24.0","template":"shippingco_signin_code_v1","language":"en"}
# Optional authentication-transport callback: also merge into LOCAL_AUTH_JSON.
# This callback is /auth/whatsapp/webhook; it is separate from shipment callbacks.
# "webhook": {"verifyToken":"REPLACE_AUTH_VERIFY_TOKEN_32_TO_128_CHARACTERS","appSecret":"REPLACE_META_APP_SECRET_32_HEX"}

# --- WhatsApp shipment updates and customer services ---
# Requires auth, applied migrations, restricted runtime grants, an installation
# connected to the real organization/franchise, approved/synchronized templates,
# activated notification policies and current customer consent.
# Organization/franchise IDs come from ShippingCo, not Meta. WABA/phone IDs come
# from Meta API Setup. REPLACE_* values are placeholders, not usable identities.
# graph_version is an explicit deployment pin: v24.0 is a syntax example,
# not a statement of Meta's latest or your account's qualified API version.
# Template language en matches the English ShippingCo submissions; en_US differs.
# The provider token belongs in credentials under the exact credential_ref key.
# No standalone WHATSAPP_ACCESS_TOKEN / WHATSAPP_APP_SECRET env vars are consumed.
# Business callback URL: https://<public-api-host>/webhooks/whatsapp
# Meta's Verify token field must equal configuration.webhook.verify_token.
# For local callbacks, point an HTTPS tunnel at the API on 127.0.0.1:3000.
# Webhook signing secret, verification token, encryption key and fingerprint key
# must be distinct. Encryption/fingerprint keys are dedicated 64-character hex.
# Retain existing keys and key_version while encrypted records still need them.
# No separate queue URL or messaging-worker environment variables are required.
# WHATSAPP_CONFIG_REF=local:whatsapp
# LOCAL_WHATSAPP_JSON='{
#   "configuration": {
#     "graph_version": "v24.0",
#     "bindings": [{
#       "key": "local_v1",
#       "organization_id": "REPLACE_ORGANIZATION_UUID",
#       "franchise_id": "REPLACE_FRANCHISE_UUID",
#       "waba_id": "REPLACE_WABA_ID",
#       "phone_number_id": "REPLACE_PHONE_NUMBER_ID",
#       "credential_ref": "whatsapp:local/v1"
#     }],
#     "webhook": {
#       "app_secret": "REPLACE_META_APP_SECRET",
#       "verify_token": "REPLACE_BUSINESS_VERIFY_TOKEN_32_TO_256_CHARACTERS",
#       "waba_ids": ["REPLACE_WABA_ID"],
#       "encryption_key": "REPLACE_INBOX_ENCRYPTION_64_HEX",
#       "fingerprint_key": "REPLACE_INBOX_FINGERPRINT_64_HEX",
#       "key_version": "v1"
#     },
#     "outbound_enabled": false,
#     "customer_access_enabled": false,
#     "conversation_enabled": false,
#     "customer_quotes_enabled": false,
#     "pickup_enabled": false,
#     "support_enabled": false,
#     "support_hours": [{
#       "franchise_id": "REPLACE_FRANCHISE_UUID",
#       "timezone": "Asia/Kolkata",
#       "weekdays": [1, 2, 3, 4, 5, 6],
#       "start_minute": 540,
#       "end_minute": 1080,
#       "staffed": false
#     }],
#     "automation": {
#       "policies": [
#         {"policy_id":"booking-confirmation","policy_version":1,"template_name":"shippingco_booking_confirmation_v1","template_language":"en","variables":["booking_id","parcel_count","confirmed_at"]},
#         {"policy_id":"parcel-checked-in","policy_version":1,"template_name":"shippingco_parcel_checked_in_v1","template_language":"en","variables":["docket","occurred_at"]},
#         {"policy_id":"parcel-dispatched","policy_version":1,"template_name":"shippingco_parcel_dispatched_v1","template_language":"en","variables":["docket","occurred_at"]},
#         {"policy_id":"route-departed","policy_version":1,"template_name":"shippingco_route_departed_v1","template_language":"en","variables":["docket","effective_at","revised_eta_at"]},
#         {"policy_id":"route-delayed","policy_version":1,"template_name":"shippingco_route_delayed_v1","template_language":"en","variables":["docket","effective_at","revised_eta_at"]},
#         {"policy_id":"route-arrived","policy_version":1,"template_name":"shippingco_route_arrived_v1","template_language":"en","variables":["docket","effective_at"]},
#         {"policy_id":"delivery-attempt-failed","policy_version":1,"template_name":"shippingco_delivery_attempt_failed_v1","template_language":"en","variables":["docket","safe_failure_reason","occurred_at"]},
#         {"policy_id":"parcel-rto-approved","policy_version":1,"template_name":"shippingco_rto_approved_v1","template_language":"en","variables":["docket","occurred_at"]},
#         {"policy_id":"delivery-completed","policy_version":1,"template_name":"shippingco_delivery_completed_v1","template_language":"en","variables":["docket","completed_at","proof_wording"]}
#       ]
#     },
#     "owner_reports": {
#       "template_name": "shippingco_owner_report_ready_v1",
#       "template_language": "en",
#       "app_origin": "http://localhost:5173"
#     }
#   },
#   "credentials": {"whatsapp:local/v1":"REPLACE_META_ACCESS_TOKEN"}
# }'
# To send booking updates, enable outbound_enabled after completing setup.
# Customer chat requires customer_access_enabled + conversation_enabled + outbound.
# Quotes additionally require customer_quotes_enabled and a published quote policy.
# Pickups require pickup_enabled + quotes; support requires support_enabled + chat.
# support_hours weekdays: 0=Sunday, 1=Monday, ... 6=Saturday; minutes are local time.
# Set staffed to match actual staffing. Sample hours are not an application default.
# owner_reports is optional; its app_origin must also be in ALLOWED_ORIGINS.
# Approval/configuration does not enroll contacts, grant shipment access or consent.
# A phone edit cannot redirect an already retained delivery recipient.

# --- Delivery verification codes / secure proof ---
# Optional for local booking-confirmation tests; required in staging/production.
# Delivery routes require this config. The Meta authentication template must be
# approved and its send shape qualified before meta_send_qualified becomes true.
# Generate distinct 32-byte verifier/encryption keys; preserve existing versions.
# DELIVERY_PROOF_SECRET_REF=local:delivery-proof
# LOCAL_DELIVERY_PROOF_JSON='{
#   "keys": {
#     "version": "v1",
#     "verifier": "REPLACE_DELIVERY_VERIFIER_64_HEX",
#     "encryption": "REPLACE_DELIVERY_ENCRYPTION_64_HEX"
#   },
#   "template": {
#     "name": "shippingco_delivery_code_v1",
#     "language": "en",
#     "meta_send_qualified": false
#   }
# }'

# --- Private attachments: S3-compatible storage and ClamAV scanner ---
# Optional locally; staging/production require this reference AND auth setup.
# Provision the private bucket and scanner separately; env does not start them.
# Bucket must be shipit-<environment>-<suffix>, e.g. shipit-developer-attachments.
# HTTP storage and non-TLS loopback scanner are development-only options.
# signingKey is an independent 32-byte base64url secret (43+ characters).
# Example generation: node -p "require('node:crypto').randomBytes(32).toString('base64url')"
# STORAGE_CREDENTIAL_REF=local:storage
# LOCAL_STORAGE_CREDENTIAL='{
#   "storage": {
#     "endpoint": "http://127.0.0.1:9000",
#     "region": "us-east-1",
#     "bucket": "shipit-developer-attachments",
#     "accessKeyId": "REPLACE_STORAGE_ACCESS_KEY_ID",
#     "secretAccessKey": "REPLACE_STORAGE_SECRET_ACCESS_KEY"
#   },
#   "scanner": {"host":"127.0.0.1","port":3310,"tls":false},
#   "signingKey": "REPLACE_ATTACHMENT_SIGNING_KEY_BASE64URL"
# }'

# --- Optional API feature flags ---
# All accept literal true/false, default false and cannot be true in demo mode.
# Apply each feature's migrations/runtime grants and domain setup before enabling.
# These switches do not grant staff roles, configure pricing or create memberships.
MONEY_RECEIPTS_ENABLED=false
FINANCIAL_WORKFLOW_ENABLED=false
CASHBOOK_ENABLED=false
CASH_CLOSE_ENABLED=false
SHIPMENT_COST_WRITES_ENABLED=false
SETTINGS_WRITES_ENABLED=false
CUSTODY_ENABLED=false
AGENT_MONEY_ENABLED=false
CUSTOMER_ACCOUNTS_ENABLED=false
RECONCILIATION_ENABLED=false
OWNER_SUMMARIES_ENABLED=false
# WhatsApp owner reports additionally need configuration.owner_reports above.

# --- Optional Groq language interpretation ---
# Deterministic customer replies work without AI. Enabled AI requires the existing
# WhatsApp conversation setup, an API key and an approved privacy-policy reference.
# Keep disabled until the deployment's privacy/data-region policy is approved.
# LLM_MODEL accepts only the exact code-owned value below; no GROQ_API_KEY alias.
LLM_ENABLED=false
# LLM_API_KEY=REPLACE_GROQ_API_KEY
LLM_MODEL=qwen/qwen3.8-27b
# LLM_PRIVACY_POLICY_REF=REPLACE_APPROVED_POLICY_REFERENCE

# --- Public browser configuration (never put secrets in VITE_* variables) ---
# Root pnpm web/dev launchers import these public values automatically.
# Vite also supports public overrides in apps/web/.env.local.
# production means the real API-backed UI, even with NODE_ENV=development above.
VITE_DATA_MODE=production
# Empty uses same-origin /auth and /api through Vite's development proxy.
VITE_API_BASE_URL=
# VITE_APP_VERSION=local
# Optional Vite dev-server target; set in its process environment to override.
# SHIPIT_API_PROXY=http://127.0.0.1:3000

# --- Optional local quality tooling (not application configuration) ---
# PYTHON=C:/path/to/python.exe
# MIGRATION_BASE_SHA=REPLACE_RELEASED_MIGRATION_BASE_COMMIT
# Disposable test database/object-store variables are owned by pnpm db:local and
# pnpm test:attachments. Do not point test runners at this developer database.
# See docs/architecture/configuration-contract.md and packages/db/README.md.
